# Copy to .env before running: cp .env.docker.example .env
#
# Local or server:
#   docker compose up -d --build
#
# Stop:
#   docker compose down
#
# Reset database (destroys all data):
#   docker compose down -v && docker compose up -d --build
#
# Seed demo portal users (admin@ubaka.site / password123):
#   SEED_PORTAL=true docker compose up -d --build

# API port exposed on the host
PORT=5000

# Postgres credentials (used by both postgres and backend containers)
DB_NAME=ubaka_attendance
DB_USER=postgres
DB_PASSWORD=change_this_secure_password
# Host port for Postgres (5433 avoids conflict with a local Postgres install)
DB_HOST_PORT=5433

# Required — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

NODE_ENV=production
LOG_LEVEL=info

# Optional SMTP (leave blank to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@ubaka.com

# Set to true on first run to load demo portal accounts
SEED_PORTAL=false
