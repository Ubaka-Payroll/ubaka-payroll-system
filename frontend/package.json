{
  "name": "ubaka-attendance",
  "version": "1.0.0",
  "description": "Ubaka Attendance Tracking System — all-in-one desktop app",
  "main": "dist/main.js",
  "author": "Ubaka Team",
  "license": "ISC",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "npm run build:electron-main && wait-on http://localhost:3000 && cross-env NODE_ENV=development UBAKA_SKIP_SERVICES=1 UBAKA_ELECTRON_DEV=1 ELECTRON_OZONE_PLATFORM_HINT=x11 electron --no-sandbox --ozone-platform=x11 .",
    "build:electron-main": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron-main && npm run build:renderer",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:win:remote": "npm run build && electron-builder --win --x64 --config electron-builder.remote.yml",
    "electron:packaged-dev": "npm run build && cross-env NODE_ENV=production ELECTRON_OZONE_PLATFORM_HINT=x11 electron --no-sandbox --ozone-platform=x11 .",
    "start": "electron --no-sandbox --ozone-platform=x11 .",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest"
  },
  "keywords": [
    "electron",
    "react",
    "desktop",
    "attendance"
  ],
  "dependencies": {
    "axios": "^1.18.1",
    "lucide-react": "^0.511.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
